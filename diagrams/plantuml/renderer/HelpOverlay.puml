@startuml
class HelpEntry <<sealed>> {
    + KeyText : string <<get>>
    + Description : string <<get>>
    + HelpEntry(keyText:string, description:string)
}
class HelpOverlay {
    + Add(keyText:string, description:string) : void
    + Entries : IReadOnlyList<HelpEntry> <<get>>
    + Show() : void
}
@enduml
